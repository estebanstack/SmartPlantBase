# Copie este archivo como .env y cambie los valores. El archivo .env NO se sube a git.

# Clave para firmar y verificar los tokens JWT. Use una cadena larga y aleatoria, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=cambie-esta-clave-por-una-larga-y-aleatoria

# De dónde se lee la tabla de referencia de especies: csv o bd
TABLA_REFERENCIA_DRIVER=csv

# Puerto del backend
PORT=5000
